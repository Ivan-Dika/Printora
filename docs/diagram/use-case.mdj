        },
        {
          "_type": "UMLUseCase",
          "_id": "9f3d90d338034bb9aaa2515350932dd3",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-05 Mengoordinasikan produksi",
          "documentation": "FO meneruskan pekerjaan setelah desain final disetujui dan DP terpenuhi. Operator melihat antrean dan memulai produksi."
        },
        {
          "_type": "UMLUseCase",
          "_id": "2efaa6c1e5c6460cbf5897c0d95f311a",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-13 Mencatat pemeriksaan hasil cetak",
          "documentation": "Operator mencatat hasil pemeriksaan (lolos atau perlu perbaikan) dengan catatan."
        },
        {
          "_type": "UMLUseCase",
          "_id": "6d64a5aed9e0416fb8c2fe299cf33474",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-01 Mencatat pesanan",
          "documentation": "Pelanggan mengajukan pesanan sendiri dari etalase atau Ruang Kerja. FO mencatat pesanan langsung atas nama pelanggan."
        },
        {
          "_type": "UMLUseCase",
          "_id": "0a3158c8a4a74101b37ca6c8689abf3a",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-02 Memantau perkembangan pesanan",
          "documentation": "Pelanggan hanya melihat pesanan sendiri; FO memantau seluruh pesanan."
        },
        {
          "_type": "UMLUseCase",
          "_id": "89ff4347a9684118b1a8b92dec6dfbca",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-03 Meninjau dan menyetujui desain",
          "documentation": "Tim desain menyediakan rancangan untuk ditinjau. Hanya pelanggan memberikan persetujuan final."
        },
        {
          "_type": "UMLUseCase",
          "_id": "650c19849312441cbbcc851d7087e435",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-04 Mengelola revisi desain",
          "documentation": "Pelanggan mengirim catatan revisi sebelum persetujuan; tim desain mengunggah hasil revisi. Dijalankan bila desain belum disetujui."
        },
        {
          "_type": "UMLUseCase",
          "_id": "7767a9c6b53a4c3ca128eb89eda2a12e",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-11 Melihat tugas desain",
          "documentation": "Tim desain melihat pekerjaan yang ditugaskan dan spesifikasi pesanan."
        },
        {
          "_type": "UMLUseCase",
          "_id": "b84b14d5f6f64e39a40b24bdab151a9d",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-12 Menetapkan berkas final",
          "documentation": "Hanya dilakukan tim desain setelah pelanggan menyetujui desain."
        },
        {
          "_type": "UMLUseCase",
          "_id": "d40dcb8041c349108c87e77c274f7a6f",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-06 Memverifikasi pesanan",
          "documentation": "FO memverifikasi spesifikasi serta menetapkan biaya, nominal DP, dan target selesai.",
          "ownedElements": [
            {
              "_type": "UMLInclude",
              "_id": "abed6c13eabf4e2a8eb0e7c823a20d9a",
              "_parent": {
                "$ref": "d40dcb8041c349108c87e77c274f7a6f"
              },
              "source": {
                "$ref": "d40dcb8041c349108c87e77c274f7a6f"
              },
              "target": {
                "$ref": "beae7e5491f54b06bedde7006ebc6162"
              }
            }
          ]
        },
        {
          "_type": "UMLUseCase",
          "_id": "beae7e5491f54b06bedde7006ebc6162",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-08 Menugaskan pekerjaan",
          "documentation": "FO menetapkan tim desain dan operator yang menangani pesanan. Dilakukan sebagai bagian dari verifikasi."
        },
        {
          "_type": "UMLUseCase",
          "_id": "e960f07fba5349c89e02ab2944394a45",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-07 Mengelola data pelanggan",
          "documentation": "FO mengelola identitas dan kontak pelanggan."
        },
        {
          "_type": "UMLUseCase",
          "_id": "c7a3396061d549c6b09c599435086b12",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-09 Mencatat DP dan pelunasan",
          "documentation": "FO mencatat pembayaran yang diterima; pelanggan tidak mengubah catatan pembayaran."
        },
        {
          "_type": "UMLUseCase",
          "_id": "da4c5f9651104f889bc1c7019a84e44b",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-10 Mengelola penyerahan hasil",
          "documentation": "FO menetapkan siap diambil, memberi tahu pelanggan, dan mencatat selesai setelah lunas serta diserahkan."
        },
        {
          "_type": "UMLUseCase",
          "_id": "c006e10635f645a4bd988d63e6866ee7",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-14 Memesan dari etalase tanpa login",
          "documentation": "Pengunjung mengisi form di etalase (layanan, spesifikasi, opsi Desain dulu atau Langsung cetak, berkas). Akun Pelanggan dibuat otomatis dan kredensial dikirim lewat WhatsApp dan email; kata sandi wajib diganti pada masuk pertama."
        },
        {
          "_type": "UMLUseCase",
          "_id": "39c06ff1d2ff4af992449f50d829a71e",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-15 Membayar tagihan (Transfer, Tunai, QRIS)",
          "documentation": "Pelanggan memilih nominal (DP atau lunas) dan metode. QRIS menampilkan kode QR yang dikonfirmasi otomatis; Transfer dan Tunai dikonfirmasi FO."
        },
        {
          "_type": "UMLUseCase",
          "_id": "4dbaa88e444d42cca30e7b85631a043e",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-16 Melihat dan mencetak kwitansi",
          "documentation": "Setiap pembayaran menghasilkan kwitansi bernomor (KW-nomor pesanan-urut) dengan cap LUNAS bila sisa tagihan nol; dapat dicetak."
        },
        {
          "_type": "UMLUseCase",
          "_id": "05c3b7da239c4eae96985ec949599a98",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-17 Menerima pemberitahuan WhatsApp dan email",
          "documentation": "Setiap perubahan status mengirim pesan WhatsApp (WAHA) dan email (SMTP) kepada pihak yang berkepentingan; hasil pengiriman dicatat pada riwayat."
        },
        {
          "_type": "UMLUseCase",
          "_id": "dfb1912956da497ebf4fe38b7de366cf",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-18 Mengelola pengguna dan master data",
          "documentation": "Admin membuat dan mengubah akun, mengatur ulang kata sandi, serta mengelola katalog layanan, metode pembayaran, dan saluran."
        },
        {
          "_type": "UMLUseCase",
          "_id": "cc64d49810a047d4b8662dabdcebc621",
          "_parent": {
            "$ref": "7b92c4d976e447f78718e68f81201e75"
          },
          "name": "UC-19 Mengatur saluran pemberitahuan",
          "documentation": "Admin mengaktifkan dan mengisi WhatsApp (WAHA) serta email (SMTP), menguji pengiriman, dan melihat riwayat 15 pengiriman terakhir. Rahasia tersimpan terenkripsi."
        }
      ],
      "documentation": "Revisi 3: ditambah aktor Admin Aplikasi dan UC-14..UC-19 (pesan tanpa login, pembayaran, kwitansi, pemberitahuan, master data, pengaturan saluran). Revisi 2: Operator dipindah ke sisi use case miliknya; penomoran UC-01..UC-13 disertakan pada nama; ditambah relasi include UC-06 -> UC-08. Revisi desain (UC-04) dijalankan hanya bila desain belum disetujui."
    }
  ]
}