            {
              "_type": "LabelView",
              "_id": "2ddd88572a664076b0e2b7abe731d001",
              "font": "Arial;13;0",
              "left": 40,
              "top": 91,
              "width": 1190,
              "height": 65,
              "text": "Prasyarat: Pesanan Desain dulu telah diverifikasi dan tugas desain sudah diberikan.",
              "wordWrap": true,
              "horizontalAlignment": 0,
              "_parent": {
                "$ref": "3c1a8c54bba14495b310d60b9a94d03f"
              }
            },
            {
              "_type": "LabelView",
              "_id": "ac924d2450ae4544aabdbfab78ed15d3",
              "font": "Arial;13;0",
              "left": 40,
              "top": 1233,
              "width": 1190,
              "height": 65,
              "text": "Catatan: Hanya pelanggan pemilik pesanan yang dapat menyetujui atau meminta revisi, dan hanya sebelum desain disetujui. Pada Langsung cetak, tahap ini dilewati karena berkas siap cetak diunggah saat memesan.",
              "wordWrap": true,
              "horizontalAlignment": 0,
              "_parent": {
                "$ref": "3c1a8c54bba14495b310d60b9a94d03f"
              }
            }
          ],
          "defaultDiagram": true,
          "showSequenceNumber": false,
          "_parent": {
            "$ref": "1e4722eaf10746af879a0d3c13cd66cc"
          }
        }
      ],
      "documentation": "Prasyarat: Pesanan Desain dulu telah diverifikasi dan tugas desain sudah diberikan.\nHanya pelanggan pemilik pesanan yang dapat menyetujui atau meminta revisi, dan hanya sebelum desain disetujui. Pada Langsung cetak, tahap ini dilewati karena berkas siap cetak diunggah saat memesan.",
      "_parent": {
        "$ref": "02c30c51758c4a5a97062fd2b7fdbce5"
      }
    },
