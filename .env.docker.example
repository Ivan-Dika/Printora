# Salin menjadi .env.docker lalu isi. Berkas .env.docker tidak boleh di-commit.
DB_ROOT_PASSWORD=ganti-root-db
DB_PASSWORD=ganti-sandi-db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-sandi-admin-aplikasi
# Di Pengaturan Admin: alamat WAHA = http://waha:3000, API key = nilai di bawah
WAHA_API_KEY=ganti-api-key-waha
WAHA_DASHBOARD_PASSWORD=ganti-sandi-dasbor-waha
# Alamat publik (domain) bila sudah online; kosong = tautan tidak disertakan di pesan
PUBLIC_URL=
# 0 = QRIS simulasi dimatikan (wajib untuk yang online); 1 = hanya untuk demo
ENABLE_DEMO_PAY=0

# Kunci enkripsi rahasia pengaturan; isi acak 64 karakter heksa dan JANGAN diganti setelahnya
SETTINGS_KEY=
